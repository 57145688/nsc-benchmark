FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue T 560
);

regions
(
    cellToCell
    {
        set core;
        fieldValues
        (
            volScalarFieldValue T 575
            volVectorFieldValue U (0 0 0.05)
        );
    }
);

